              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('devuelve token', () => pm.expect(j.access_token).to.be.a('string').and.not.empty);",
                  "pm.test('devuelve el usuario', () => pm.expect(j.user.email).to.eql(pm.collectionVariables.get('email')));",
                  "pm.collectionVariables.set('token', j.access_token);"
