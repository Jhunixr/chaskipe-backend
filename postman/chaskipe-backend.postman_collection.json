{
  "info": {
    "name": "Chaski Pe — backend",
    "description": "Pruebas del backend de Chaski Pe (FastAPI). Elige el entorno (local o VPS) y usa Run collection: cada corrida crea una cuenta de prueba nueva (postman_<fecha>@prueba.chaskipe.pe). No sube muestras al dataset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Estado",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(j.status).to.eql('ok'));",
                  "pm.test('usa PostgreSQL (no memoria)', () => pm.expect(j.persistence).to.eql('postgresql'));",
                  "pm.test('responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
