          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo unico en cada corrida",
                  "pm.collectionVariables.set('email', `postman_${Date.now()}@prueba.chaskipe.pe`);",
                  "if (!pm.collectionVariables.get('password')) pm.collectionVariables.set('password', 'ClavePrueba123');"
