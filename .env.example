# Variables del backend de Chaski Pe. Copia a .env (desarrollo) o pegalas en
# la pestana Environment de Dokploy (produccion). Ver backend/README.md.

# development | production  (production exige SECRET_KEY y base de datos)
CHASKIPE_ENVIRONMENT=development

# Tal cual la da Dokploy ("Internal Connection URL" de chaskipe-db):
#   postgresql://chaskipe:<password>@chaskipe-chaskipedb-xxxx:5432/chaskipe
# En local, con `docker compose up -d db`:
CHASKIPE_DATABASE_URL=postgresql://chaskipe:chaskipe@localhost:5432/chaskipe

# Firma de los tokens de sesion. OBLIGATORIA en produccion:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHASKIPE_SECRET_KEY=

# Dominio(s) del frontend en produccion (lista JSON).
# CHASKIPE_CORS_ORIGINS=["https://chaskipe.ejemplo.pe"]

# Muestras del dataset subidas desde la app (en Docker: volumen en /app/data).
# CHASKIPE_DATASET_DIR=data/dataset

# Habilita GET /api/v1/dataset/export (cabecera X-Admin-Token). Vacio = desactivado.
CHASKIPE_ADMIN_TOKEN=
